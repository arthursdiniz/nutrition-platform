# Shared development defaults. Do not commit real secrets.
POSTGRES_DB=nutrition
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition_dev_password
POSTGRES_PORT=5433

# The API deliberately uses a namespaced set of database variables so unrelated
# machine-level DATABASE_* variables cannot override local development settings.
NUTRITION_DATABASE_URL=jdbc:postgresql://localhost:5433/nutrition
NUTRITION_DATABASE_USERNAME=nutrition
NUTRITION_DATABASE_PASSWORD=nutrition_dev_password

# Backend
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-a-32-byte-minimum-development-secret
AI_PROVIDER=mock
SUBSCRIPTION_PROVIDER=mock
STORAGE_PROVIDER=local

# Mobile (use your machine LAN IP for a physical device)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
